{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/notes/:path*",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shixilin.vercel.app"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.shixilin.com"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/works/:path*",
      "destination": "/ai",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/games/ink-duel",
      "destination": "/games/ink-duel/index.html"
    },
    {
      "source": "/games/baishishu",
      "destination": "/games/baishishu/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/ai",
      "destination": "/ai/index.html"
    },
    {
      "source": "/books",
      "destination": "/books/index.html"
    },
    {
      "source": "/ai/yunjian",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian"
    },
    {
      "source": "/ai/yunjian/:path*",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
