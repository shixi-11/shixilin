{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/notes/",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/works/",
      "destination": "/ai",
      "permanent": true
    },
    {
      "source": "/:locale(zh-Hant|zh|en|ja|ko|es|fr|de|ar)/",
      "destination": "/?lang=:locale",
      "permanent": false
    },
    {
      "source": "/:locale(zh-Hant|zh|en|ja|ko|es|fr|de|ar)",
      "destination": "/?lang=:locale",
      "permanent": false
    },
    {
      "source": "/:locale(zh-Hant|zh|en|ja|ko|es|fr|de|ar)/:path+/",
      "destination": "/:path+/?lang=:locale",
      "permanent": false
    },
    {
      "source": "/:locale(zh-Hant|zh|en|ja|ko|es|fr|de|ar)/:path+",
      "destination": "/:path+?lang=:locale",
      "permanent": false
    },
    {
      "source": "/ai/codex-reset/",
      "destination": "/ai/codex-claude-resets/",
      "permanent": true
    },
    {
      "source": "/ai/codex-reset/:path*/",
      "destination": "/ai/codex-claude-resets/:path*/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/zh",
      "destination": "/ai/codex-claude-resets/zh/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/zh-Hant",
      "destination": "/ai/codex-claude-resets/zh-Hant/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/ja",
      "destination": "/ai/codex-claude-resets/ja/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/ko",
      "destination": "/ai/codex-claude-resets/ko/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/es",
      "destination": "/ai/codex-claude-resets/es/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/fr",
      "destination": "/ai/codex-claude-resets/fr/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/de",
      "destination": "/ai/codex-claude-resets/de/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/ar",
      "destination": "/ai/codex-claude-resets/ar/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/events/:id",
      "destination": "/ai/codex-claude-resets/events/:id/",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets/:locale/events/:id",
      "destination": "/ai/codex-claude-resets/:locale/events/:id/",
      "permanent": true
    },
    {
      "source": "/ai/codex-reset",
      "destination": "/ai/codex-claude-resets/",
      "permanent": true
    },
    {
      "source": "/ai/codex-reset/:path*",
      "destination": "/ai/codex-claude-resets/:path*",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets",
      "destination": "/ai/codex-claude-resets/",
      "permanent": true
    },
    {
      "source": "/notes/:path*",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shixilin.vercel.app"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.shixilin.com"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/works/:path*",
      "destination": "/ai",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/games/lianzhu",
      "destination": "https://lianzhu.vercel.app/games/lianzhu/"
    },
    {
      "source": "/games/lianzhu/",
      "destination": "https://lianzhu.vercel.app/games/lianzhu/"
    },
    {
      "source": "/games/lianzhu/:path*",
      "destination": "https://lianzhu.vercel.app/games/lianzhu/:path*"
    },
    {
      "source": "/api/visitor-locale",
      "destination": "/api/visitor-locale"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/zh/",
      "source": "/ai/codex-claude-resets/zh"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/zh/",
      "source": "/ai/codex-claude-resets/zh/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/zh-Hant/",
      "source": "/ai/codex-claude-resets/zh-Hant"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/zh-Hant/",
      "source": "/ai/codex-claude-resets/zh-Hant/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ja/",
      "source": "/ai/codex-claude-resets/ja"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ja/",
      "source": "/ai/codex-claude-resets/ja/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ko/",
      "source": "/ai/codex-claude-resets/ko"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ko/",
      "source": "/ai/codex-claude-resets/ko/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/es/",
      "source": "/ai/codex-claude-resets/es"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/es/",
      "source": "/ai/codex-claude-resets/es/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/fr/",
      "source": "/ai/codex-claude-resets/fr"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/fr/",
      "source": "/ai/codex-claude-resets/fr/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/de/",
      "source": "/ai/codex-claude-resets/de"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/de/",
      "source": "/ai/codex-claude-resets/de/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ar/",
      "source": "/ai/codex-claude-resets/ar"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/ar/",
      "source": "/ai/codex-claude-resets/ar/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/events/:id/",
      "source": "/ai/codex-claude-resets/events/:id"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/:locale/events/:id/",
      "source": "/ai/codex-claude-resets/:locale/events/:id"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/events/:id/",
      "source": "/ai/codex-claude-resets/events/:id/"
    },
    {
      "destination": "https://codex-claude-resets.vercel.app/:locale/events/:id/",
      "source": "/ai/codex-claude-resets/:locale/events/:id/"
    },
    {
      "source": "/ai/codex-claude-resets",
      "destination": "https://codex-claude-resets.vercel.app/"
    },
    {
      "source": "/ai/codex-claude-resets/",
      "destination": "https://codex-claude-resets.vercel.app/"
    },
    {
      "source": "/ai/codex-claude-resets/:path*",
      "destination": "https://codex-claude-resets.vercel.app/:path*"
    },
    {
      "source": "/ai/agent-daily",
      "destination": "/api/agent-daily"
    },
    {
      "source": "/ai/agent-daily/",
      "destination": "/api/agent-daily"
    },
    {
      "source": "/ai/agent-daily/(.*)",
      "destination": "/api/agent-daily?dailyPath=$1"
    },
    {
      "source": "/ai/yunjian/",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian"
    },
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/games/ink-duel",
      "destination": "/games/ink-duel/index.html"
    },
    {
      "source": "/games/baishishu",
      "destination": "/games/baishishu/index.html"
    },
    {
      "source": "/design",
      "destination": "/design/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/ai",
      "destination": "/ai/index.html"
