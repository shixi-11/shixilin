{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/ai/codex-reset",
      "destination": "/ai/codex-claude-resets/",
      "permanent": true
    },
    {
      "source": "/ai/codex-reset/:path*",
      "destination": "/ai/codex-claude-resets/:path*",
      "permanent": true
    },
    {
      "source": "/ai/codex-claude-resets",
      "destination": "/ai/codex-claude-resets/",
      "permanent": true
    },
    {
      "source": "/notes/:path*",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shixilin.vercel.app"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.shixilin.com"
        }
      ],
      "destination": "https://shixilin.com/:path*",
      "permanent": true
    },
    {
      "source": "/works/:path*",
      "destination": "/ai",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/zh/index.html",
      "source": "/ai/codex-claude-resets/zh"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/zh/index.html",
      "source": "/ai/codex-claude-resets/zh/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/zh-Hant/index.html",
      "source": "/ai/codex-claude-resets/zh-Hant"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/zh-Hant/index.html",
      "source": "/ai/codex-claude-resets/zh-Hant/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ja/index.html",
      "source": "/ai/codex-claude-resets/ja"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ja/index.html",
      "source": "/ai/codex-claude-resets/ja/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ko/index.html",
      "source": "/ai/codex-claude-resets/ko"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ko/index.html",
      "source": "/ai/codex-claude-resets/ko/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/es/index.html",
      "source": "/ai/codex-claude-resets/es"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/es/index.html",
      "source": "/ai/codex-claude-resets/es/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/fr/index.html",
      "source": "/ai/codex-claude-resets/fr"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/fr/index.html",
      "source": "/ai/codex-claude-resets/fr/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/de/index.html",
      "source": "/ai/codex-claude-resets/de"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/de/index.html",
      "source": "/ai/codex-claude-resets/de/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ar/index.html",
      "source": "/ai/codex-claude-resets/ar"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/ar/index.html",
      "source": "/ai/codex-claude-resets/ar/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/events/:id/index.html",
      "source": "/ai/codex-claude-resets/events/:id"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/:locale/events/:id/index.html",
      "source": "/ai/codex-claude-resets/:locale/events/:id"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/events/:id/index.html",
      "source": "/ai/codex-claude-resets/events/:id/"
    },
    {
      "destination": "https://shixi-11.github.io/codex-claude-resets/:locale/events/:id/index.html",
      "source": "/ai/codex-claude-resets/:locale/events/:id/"
    },
    {
      "source": "/ai/codex-claude-resets",
      "destination": "https://shixi-11.github.io/codex-claude-resets/index.html"
    },
    {
      "source": "/ai/codex-claude-resets/",
      "destination": "https://shixi-11.github.io/codex-claude-resets/index.html"
    },
    {
      "source": "/ai/codex-claude-resets/:path*",
      "destination": "https://shixi-11.github.io/codex-claude-resets/:path*"
    },
    {
      "source": "/ai/agent-daily",
      "destination": "/api/agent-daily"
    },
    {
      "source": "/ai/agent-daily/",
      "destination": "/api/agent-daily"
    },
    {
      "source": "/ai/agent-daily/(.*)",
      "destination": "/api/agent-daily?dailyPath=$1"
    },
    {
      "source": "/ai/yunjian/",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian"
    },
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/games/ink-duel",
      "destination": "/games/ink-duel/index.html"
    },
    {
      "source": "/games/baishishu",
      "destination": "/games/baishishu/index.html"
    },
    {
      "source": "/design",
      "destination": "/design/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/support",
      "destination": "/support/index.html"
    },
    {
      "source": "/ai",
      "destination": "/ai/index.html"
    },
    {
      "source": "/books",
      "destination": "/books/index.html"
    },
    {
      "source": "/ai/yunjian",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian"
    },
    {
      "source": "/ai/yunjian/:path*",
      "destination": "https://yunjian-omega.vercel.app/ai/yunjian/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
